// Manages upgrade eligibility evaluation for a cluster.
resource UpgradeEligibility {
    // Evaluates whether the cluster is eligible for an upgrade and returns
    // structured findings for any blockers or warnings.
    //
    // This is a read-only diagnostic endpoint. It does not schedule an upgrade
    // or modify any cluster state.
    method Get {
        // TargetVersion is the specific upgrade target to check eligibility for.
        // When omitted, the check evaluates whether any upgrade target is
        // available and reports general cluster readiness.
        // Accepts X.Y (minor), X.Y.Z (patch), or X.Y.Z-prerelease formats.
        in TargetVersion String

        // Body contains the upgrade eligibility evaluation result.
        out Body UpgradeEligibility
    }
}
