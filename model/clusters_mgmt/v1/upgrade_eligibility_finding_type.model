// A single finding from the upgrade eligibility evaluation.
class UpgradeEligibilityFinding {
    // Severity of the finding.
    Severity UpgradeEligibilityFindingSeverity

    // ReasonCode is a stable machine-readable identifier for this finding type,
    // suitable for programmatic handling (e.g. CLUSTER_NOT_READY, LIMITED_SUPPORT,
    // UPGRADE_IN_FLIGHT, NO_TARGETS_AVAILABLE, GATE_UNACKNOWLEDGED, AT_LATEST_VERSION).
    ReasonCode String

    // Owner identifies who must act to resolve this finding.
    Owner UpgradeEligibilityFindingOwner

    // Summary is a short human-readable description of the finding.
    Summary String

    // Detail provides additional context explaining why this finding was raised.
    Detail String

    // Action describes the recommended remediation step.
    Action String
}
