// Representation of one upgrade scheduled somewhere in the fleet, regardless of
// which kind of upgrade policy scheduled it. Read-only; the authoritative
// resource is linked from 'policy'.
class ScheduledUpgrade {
	// Kind of upgrade: 'OSD', 'ControlPlane', 'ControlPlaneCVE', or 'NodePool'.
	// Both control plane types are scheduled by a control plane upgrade policy,
	// so "type like 'ControlPlane%'" searches for all of them.
	Type UpgradeType

	// Desired upgrade version.
	Version String

	// Next time the upgrade should run.
	NextRun Date

	// Schedule type of the upgrade.
	ScheduleType ScheduleType

	// Current state of the upgrade.
	State UpgradePolicyState

	// Creation timestamp. Not tracked for 'OSD' upgrades (null for those).
	CreatedAt Date

	// Last update timestamp. Not tracked for 'OSD' upgrades (null for those).
	UpdatedAt Date

	// Cluster this upgrade is scheduled for (enriched link).
	link Cluster Cluster

	// Node pool being upgraded. Only set for 'NodePool' upgrades.
	link NodePool NodePool

	// Link to the upgrade policy that scheduled this upgrade.
	Policy ScheduledUpgradePolicyLink
}

// Reference to one of the three kinds of upgrade policy resource. Kind
// identifies which policy type it is; id and href come from the standard
// metadata added by the generator.
class ScheduledUpgradePolicyLink {
}
